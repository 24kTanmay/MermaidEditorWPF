<Window x:Class="Mermaid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        xmlns:local="clr-namespace:Mermaid"
        mc:Ignorable="d"
        Title="Mermaid Pro Desktop" Height="720" Width="1280"
        Icon="Assets/Mermaid.ico"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" ResizeBorderThickness="8" GlassFrameThickness="1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                        Grid.ColumnSpan="2"
                        CornerRadius="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" />
                <Path x:Name="Arrow" 
                      Grid.Column="1" 
                      Fill="{TemplateBinding Foreground}"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="#2d2d2d" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Name="ToggleButton" 
                              Template="{StaticResource ComboBoxToggleButton}" 
                              Grid.Column="2" 
                              Focusable="false"
                              IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Foreground="{TemplateBinding Foreground}"/>
                <ContentPresenter Name="ContentSite"
                                  IsHitTestVisible="False" 
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="10,3,23,3"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />
                <Popup Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" 
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Grid Name="DropDown"
                          SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder"
                                Background="{StaticResource BgHeader}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderColor}"
                                CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.3"/>
                                </Border.Effect>
                        </Border>
                        <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColor}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BgStatus}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu Bar Button Style (for File, Edit, View etc.) -->
        <Style x:Key="MenuBarButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="8,4"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2d2d2d"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="1" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2a8b5cf6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgBody}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Bar + Menu -->
            <RowDefinition Height="40"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>  <!-- Workspace -->
            <RowDefinition x:Name="StatusBarRow" Height="24"/> <!-- Status -->
        </Grid.RowDefinitions>

        <!-- 1. TITLE BAR & MENU -->
        <Border x:Name="TitleBarBorder" Height="35" Grid.Row="0" Background="{StaticResource BgHeader}" BorderBrush="Black" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                    <ColumnDefinition Width="Auto"/> <!-- Title -->
                    <ColumnDefinition Width="Auto"/> <!-- Menu -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Window Controls -->
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Image Source="Assets/Mermaid.ico" Width="18" Height="18" Margin="12,0,8,0" VerticalAlignment="Center"/>

                <!-- Menu -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button Name="BtnFileMenu" Content="File"
                            Style="{StaticResource MenuBarButtonStyle}" Click="FileMenu_Click"/>

                    <Button Name="BtnEditMenu" Content="Edit"
                            Style="{StaticResource MenuBarButtonStyle}" Click="EditMenu_Click"/>

                    <Button Name="BtnViewMenu" Content="View"
                            Style="{StaticResource MenuBarButtonStyle}" Click="ViewMenu_Click"/>

                    <Button Name="BtnSearchMenu" Content="Search"
                            Style="{StaticResource MenuBarButtonStyle}" Click="SearchMenu_Click"/>

                    <Button Name="BtnHelpMenu" Content="Help"
                            Style="{StaticResource MenuBarButtonStyle}" Click="HelpMenu_Click"/>

                </StackPanel>


                
                <!-- Window Controls -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="Minimize_Click" Style="{StaticResource WindowControlButtonStyle}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" ToolTip="Minimize"/>
                    <Button Name="BtnMaximize" Click="Maximize_Click" Style="{StaticResource WindowControlButtonStyle}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" ToolTip="Maximize"/>
                    <Button Click="CloseWindow_Click" Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- File Menu Popup -->
        <Popup Name="FileMenuPopup" 
               PlacementTarget="{Binding ElementName=BtnFileMenu}" 
               Placement="Relative" 
               VerticalOffset="{Binding ActualHeight, ElementName=BtnFileMenu}"
               HorizontalOffset="0" 
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
            <Border Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel MinWidth="200">
                    <Button Style="{StaticResource MenuButtonStyle}" Content="New Diagram" Tag="Ctrl+N" Click="New_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Open..." Tag="Ctrl+O" Click="Open_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Open Recent" Tag="›" Click="OpenRecent_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Close" Tag="Ctrl+W" Click="Close_Click"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,6"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Save" Tag="Ctrl+S" Click="Save_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Save As..." Tag="Ctrl+Shift+S" Click="SaveAs_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Save All" Tag="Ctrl+Alt+S" Click="SaveAll_Click"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,6"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Export as PNG" Click="SavePng_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Export as SVG" Click="SaveSvg_Click"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,6"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Exit" Tag="Alt+F4" Click="Exit_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Edit Menu Popup -->
        <Popup Name="EditMenuPopup" 
               PlacementTarget="{Binding ElementName=BtnEditMenu}" 
               Placement="Relative" 
               VerticalOffset="{Binding ActualHeight, ElementName=BtnEditMenu}"
               HorizontalOffset="0" 
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
            <Border Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel MinWidth="180">
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Undo" Tag="Ctrl+Z" Click="Undo_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Redo" Tag="Ctrl+Y" Click="Redo_Click"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,6"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Cut" Tag="Ctrl+X" Click="Cut_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Copy" Tag="Ctrl+C" Click="Copy_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Paste" Tag="Ctrl+V" Click="Paste_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Select All" Tag="Ctrl+A" Click="SelectAll_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- View Menu Popup -->
        <Popup Name="ViewMenuPopup" 
               PlacementTarget="{Binding ElementName=BtnViewMenu}" 
               Placement="Relative" 
               VerticalOffset="{Binding ActualHeight, ElementName=BtnViewMenu}"
               HorizontalOffset="0" 
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
            <Border Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel MinWidth="180">
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Editor Only" Click="ViewEditorOnly_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Preview Only" Click="ViewPreviewOnly_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Split View" Click="ViewSplit_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Search Menu Popup -->
        <Popup Name="SearchMenuPopup" 
               PlacementTarget="{Binding ElementName=BtnSearchMenu}" 
               Placement="Relative" 
               VerticalOffset="{Binding ActualHeight, ElementName=BtnSearchMenu}"
               HorizontalOffset="0" 
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
            <Border Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel MinWidth="180">
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Find..." Tag="Ctrl+F" Click="Find_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Find Next" Tag="F3" Click="FindNext_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Find Previous" Tag="Shift+F3" Click="FindPrevious_Click"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,6"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Replace..." Tag="Ctrl+H" Click="Replace_Click"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,6"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Go to Line..." Tag="Ctrl+G" Click="GoToLine_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Help Menu Popup -->
        <Popup Name="HelpMenuPopup" 
               PlacementTarget="{Binding ElementName=BtnHelpMenu}" 
               Placement="Relative" 
               VerticalOffset="{Binding ActualHeight, ElementName=BtnHelpMenu}"
               HorizontalOffset="0" 
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
            <Border Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel MinWidth="180">
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Check for Updates..." Click="CheckUpdates_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Visit Site" Click="VisitSite_Click"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,6"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="Keyboard Shortcuts" Click="KeyboardShortcuts_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 2. TOOLBAR -->
        <Border Grid.Row="1" Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource HeaderButtonStyle}" ToolTip="New File" Width="28" Height="28" Padding="0">
                                <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zM6 20V4h7v5h5v11H6z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource HeaderButtonStyle}" Click="Open_Click" ToolTip="Open File" Width="28" Height="28" Padding="0">
                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource HeaderButtonStyle}" Click="Save_Click" ToolTip="Save MMD" Width="28" Height="28" Padding="0">
                                <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Render Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0" Padding="0,0,6,0">
                        <Button Style="{StaticResource HeaderButtonStyle}" Click="Render_Click" ToolTip="Render Diagram (F5)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M5,3 L19,12 L5,21 Z" Fill="{StaticResource AccentColor}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Render" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <!-- Export Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource HeaderButtonStyle}" Click="SavePng_Click" ToolTip="Export PNG" Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="PNG" FontSize="12" Foreground="{StaticResource TextAccent}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource HeaderButtonStyle}" Click="SaveSvg_Click" ToolTip="Export SVG">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2m0 10c2.7 0 5.8 1.29 6 2H6c.23-.72 3.31-2 6-2m0-12C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 10c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="SVG" FontSize="12" Foreground="{StaticResource TextAccent}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Themes & Layout -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Name="CboLayout" Width="110" Margin="0,0,8,0" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="CboLayout_SelectionChanged">
                        <ComboBoxItem Content="Hierarchical" Tag="dagre" IsSelected="True"/>
                        <ComboBoxItem Content="Adaptive" Tag="elk"/>
                    </ComboBox>
                    <Button Name="BtnTheme" Content="Graph Theme: Dark" Style="{StaticResource HeaderButtonStyle}" FontSize="11" ToolTip="Toggle Preview Theme" Click="TogglePreviewTheme_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. WORKSPACE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="250"/> <!-- Editor -->
                <ColumnDefinition x:Name="SplitterColumn" Width="4"/> <!-- Splitter -->
                <ColumnDefinition x:Name="PreviewColumn" Width="1.2*" MinWidth="250"/> <!-- Preview -->
            </Grid.ColumnDefinitions>

            <!-- EDITOR -->
            <Grid Grid.Column="0" Background="{StaticResource BgEditor}">
                <TabControl Name="EditorTabs" 
                            Background="{StaticResource BgEditor}" 
                            BorderThickness="0" 
                            ItemContainerStyle="{StaticResource EditorTabItemStyle}"
                            SelectionChanged="EditorTabs_SelectionChanged"
                            Button.Click="CloseTab_Click">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="{StaticResource BgTabStrip}"/>
                        </Style>
                    </TabControl.Resources>
                </TabControl>

                <!-- Search Overlay -->
                <Border Name="SearchPanel" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,10,20,0" 
                        Width="340"
                        Background="{StaticResource BgHeader}" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="6"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Find Row -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Input -->
                                <ColumnDefinition Width="Auto"/> <!-- Controls -->
                            </Grid.ColumnDefinitions>

                            <Button Click="ToggleReplace_Click" Style="{StaticResource HeaderButtonStyle}" Padding="0" Margin="0,0,4,0" Width="20" Height="20" ToolTip="Toggle Replace">
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                      Fill="{StaticResource TextSecondary}" 
                                      Width="14" Height="14" Stretch="Uniform" 
                                      VerticalAlignment="Center"/>
                            </Button>

                            <TextBox Name="SearchBox" 
                                     Grid.Column="1"
                                     Background="Transparent" 
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{StaticResource TextActive}"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown"
                                     Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Name="SearchStatus" 
                                           Text="No results" 
                                           Foreground="{StaticResource TextSecondary}" 
                                           FontSize="11" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,8,0"/>

                                <Button Click="FindPrevious_Click" Style="{StaticResource HeaderButtonStyle}" Padding="0" Margin="0" Width="24" Height="24" ToolTip="Previous Match (Shift+Enter)">
                                    <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <Button Click="FindNext_Click" Style="{StaticResource HeaderButtonStyle}" Padding="0" Margin="0" Width="24" Height="24" ToolTip="Next Match (Enter)">
